# Copia este archivo como .env y rellena los valores. El .env NO se sube al repositorio.

# Base de datos (sugerido: mydb)
MYSQL_DATABASE=

# Credenciales de MySQL
MYSQL_ROOT_PASSWORD=
# Usuarios de aplicación: 64 caracteres hexadecimales -> openssl rand -hex 32
MYSQL_SPRING_PASSWORD=
MYSQL_FAST_PASSWORD=

# Token compartido Spring -> FastAPI (encabezado X-Internal-Token) -> openssl rand -hex 32
INTERNAL_TOKEN=

# Dirección pública que va dentro del QR (sugerido: http://localhost).
# Para la demo con celular: http://<IP del portátil en la red local>
PUBLIC_BASE_URL=

# Puertos
# Puerto público de Nginx (sugerido: 80; con Podman rootless, 8081)
NGINX_HTTP_PORT=
# Solo con compose.debug.yaml (sugerido: 3307)
MYSQL_PORT=

# Datos de demostración (V6 y pasaportes DEMO): true o false
RUN_DEMO_SEED=
