# Copia este archivo como .env y rellena los valores. El .env NO se sube al repositorio.

# Base de datos (sugerido: vetlink)
MYSQL_DATABASE=

# Credenciales de MySQL
MYSQL_ROOT_PASSWORD=
# Usuarios de aplicación: 64 caracteres hexadecimales -> openssl rand -hex 32
MYSQL_SPRING_PASSWORD=
MYSQL_FAST_PASSWORD=

# Token compartido Spring -> FastAPI (encabezado X-Internal-Token) -> openssl rand -hex 32
INTERNAL_TOKEN=

# Dirección PÚBLICA que va dentro del QR y de los enlaces compartidos.
# - Producción: tu dominio con HTTPS, p. ej. https://vetlink.midominio.com
# - Pruebas desde datos móviles sin dominio: perfil "tunel" (ver README) y pega aquí la URL https://...trycloudflare.com
# - http://localhost o una IP privada (192.168.x.x) SOLO funcionan en este equipo o en la misma Wi-Fi.
PUBLIC_BASE_URL=

# desarrollo | produccion (en producción el servicio advierte si PUBLIC_BASE_URL no usa HTTPS)
VETLINK_ENTORNO=desarrollo

# true = el pasaporte público muestra motivos, diagnósticos y medicamentos (por defecto false: privacidad)
PASAPORTE_DETALLE_CLINICO=false

# Puertos
# Puerto público de Nginx (sugerido: 80; con Podman rootless, 8081)
NGINX_HTTP_PORT=
# Solo con compose.debug.yaml (sugerido: 3307)
MYSQL_PORT=

# Datos de demostración (V6 y pasaportes DEMO): true o false
RUN_DEMO_SEED=
